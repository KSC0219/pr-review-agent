# --- LLM ---
LLM_PROVIDER=anthropic          # anthropic | baseline (rule-based, no API key needed)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Prices in USD per million tokens, used only for the cost report. Check current pricing.
PRICE_INPUT_PER_MTOK=1.0
PRICE_OUTPUT_PER_MTOK=5.0

# --- GitHub ---
PR_BACKEND=github               # github | local (reads .diff files from LOCAL_PR_DIR)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
LOCAL_PR_DIR=examples

# --- Behaviour ---
AUTO_APPROVE=false              # true = post comments without human approval
MAX_COMMENTS=10
MCP_TRANSPORT=stdio             # stdio | inprocess
TRACE_FILE=traces/trace.jsonl
